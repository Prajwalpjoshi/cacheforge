# Copy to .env and adjust as needed. Never commit the real .env file.
#
# This file is read by `docker compose` (it auto-loads `.env` from the
# directory containing docker-compose.yml) to configure the local
# Postgres container's credentials.
#
# apps/api reads its OWN .env — see apps/api/.env.example — because
# Node's process.loadEnvFile() resolves relative to the process's cwd,
# which is apps/api when pnpm runs that workspace's scripts. Likewise
# apps/web reads its own .env.local for NEXT_PUBLIC_* vars (Next.js's
# built-in convention).

POSTGRES_USER=cacheforge
POSTGRES_PASSWORD=cacheforge
POSTGRES_DB=cacheforge
