# Copy to .env and adjust as needed. Never commit the real .env file.

# --- apps/api ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (not yet consumed by the API — Prisma integration lands in a later phase)
POSTGRES_USER=cacheforge
POSTGRES_PASSWORD=cacheforge
POSTGRES_DB=cacheforge
DATABASE_URL=postgresql://cacheforge:cacheforge@localhost:5432/cacheforge

# Redis (not yet consumed by the API — cache-kit integration lands in a later phase)
REDIS_URL=redis://localhost:6379

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
