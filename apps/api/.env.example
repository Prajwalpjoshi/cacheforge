# Copy to apps/api/.env and adjust as needed. Never commit the real .env file.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Must match the credentials in the repo-root .env used by docker compose.
DATABASE_URL=postgresql://cacheforge:cacheforge@localhost:5432/cacheforge
REDIS_URL=redis://localhost:6379

# Fixed-window rate limiting (all optional; these are the built-in defaults).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
