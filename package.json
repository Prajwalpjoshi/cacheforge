{
  "name": "cacheforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Observe. Cache. Measure. Optimize. — a production-style API performance and Redis caching platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --filter \"./packages/*\" build && pnpm --recursive --filter \"./apps/*\" build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:unit": "pnpm --recursive run test:unit",
    "test:integration": "pnpm --recursive run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
